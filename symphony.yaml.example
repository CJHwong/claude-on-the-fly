# claude-symphony daemon config.
# Place at ~/.claude-on-the-fly/symphony.yaml.
# Edit and re-save while running to hot-reload prompts; restart to apply changes
# in this file (e.g. adding a tracker, changing polling cadence).

# -- Multi-tracker shape (recommended) ---------------------------------------
# Each source has its own active/terminal states, gate label, and prompt path.
# The daemon polls every configured tracker in parallel and shares the global
# `max_concurrent` budget across sources.

trackers:
  jira:
    kind: jira                      # registered in SUPPORTED_TRACKERS
    base_url: https://your-org.atlassian.net
    email: $JIRA_EMAIL                # resolved against os.environ
    api_token: $JIRA_API_TOKEN
    project_key: PROJ
    jql_extra: 'AND assignee = currentUser() AND labels = "stevedore"'
    # Defaults shown; uncomment to override:
    # active_states:   ["To Do", "In Progress"]
    # terminal_states: ["Done", "Closed", "Cancelled"]
    # gate_label: stevedore           # agent removes this to park / finish
    prompt: ./symphony-prompt-jira.md
    # max_concurrent_by_state:        # per-state caps on top of global
    #   "rework": 1
    #   "in progress": 5

  github:
    kind: github                    # PRs requesting your review (gh CLI auth)
    # `gh` must be on PATH and authenticated (gh auth login).
    # GitHub adapter needs no extra fields — submitting any review removes
    # you from `reviewRequests`, which is symphony's "done" signal.
    # Defaults shown; uncomment to override:
    # active_states:   ["open"]
    # terminal_states: ["closed", "merged"]
    prompt: ./symphony-prompt-github.md

# -- Global limits (apply across all sources) --------------------------------
# polling_ms: 30000
# max_concurrent: 1                  # cap across ALL trackers combined
# max_turns: 20                      # -1 = unlimited; then stall_timeout_ms only
# turn_timeout_ms: 3600000
# stall_timeout_ms: 1800000
# max_retry_backoff_ms: 300000

# -- Backward compat ---------------------------------------------------------
# The legacy singular `tracker:` form (with top-level `prompt:`, `gate_label:`,
# and `max_concurrent_by_state:`) is still accepted and auto-wrapped into a
# single-entry trackers map. Existing configs keep working without edits.
