{
  "display_information": {
    "name": "Claude On The Fly",
    "description": "Remote Claude Code access via Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Claude On The Fly",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/cof-CHANGEME",
        "description": "Run a skill; in threads use the shortcut",
        "usage_hint": "[skill] [args]",
        "should_escape": false
      }
    ],
    "shortcuts": [
      {
        "name": "Run a skill",
        "type": "message",
        "callback_id": "cof_run_skill",
        "description": "Open the skill picker for this thread"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:write",
        "usergroups:read",
        "usergroups:write",
        "users:read"
      ],
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:write",
        "search:read",
        "usergroups:read",
        "usergroups:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ],
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
