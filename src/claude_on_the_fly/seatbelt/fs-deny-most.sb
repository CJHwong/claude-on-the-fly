;; fs-deny-most.sb: least-privilege filesystem base (COTF_SANDBOX_FS=deny-most).
;;
;; Derived from agent-seatbelt's my.deny-most.sb. Keep the rule order and
;; structure aligned with upstream so its changes stay diffable.
;;
;; Same shape as fs-allow-reads.sb, but the home directory is opaque by default. Where fs-allow-reads.sb
;; does a global (allow file-read*) with a secret denylist, this denies every
;; read under _HOME and then re-grants only what the agent needs, plus up to
;; three operator-named paths (_EXTRA_1.._EXTRA_3, from COTF_SANDBOX_EXTRA_PATHS).
;; Reads outside _HOME (system libraries, the toolchain) stay allowed so the
;; binaries the agent runs still start.
;;
;; This is coarser than fs-allow-reads.sb by design: an agent that reads dotfiles outside
;; the re-granted set (e.g. ~/.gitconfig, ~/.npmrc) will be denied. Grant those
;; explicitly via COTF_SANDBOX_EXTRA_PATHS if a run needs them.
;;
;; cotf's own data-dir re-grants (shims/ and memory/) are scoped to _DATA_DIR,
;; which the wrapper resolves from the daemon's data directory (COTF_DATA_DIR
;; when redirected). Only the daemon's own shims and memory are re-granted: a
;; redirected daemon's data dir lives under _HOME and stays opaque like the rest.
;;
;; Parameters (injected by the wrapper): _HOME, _DATA_DIR, _PROJECT_DIR, _TMPDIR,
;; _CLAUDE_PROJECTS, _CLAUDE_PROJECT, _EXTRA_1.._EXTRA_3 and _RUNTIME_1.._RUNTIME_5
;; (unused slots resolve to _PROJECT_DIR, a harmless no-op).

(version 1)
(deny default)

;; -- Process & system essentials (mirrors fs-allow-reads.sb) --
(allow process-exec)
(allow process-fork)
(allow process-info*)
(allow signal)
(allow mach*)
(allow sysctl*)
(allow ipc-posix-shm*)
(allow ipc-posix-sem*)
(allow iokit-open)
(allow system-socket)
(allow system-fsctl)
(allow pseudo-tty)
(allow user-preference-read)
(allow file-ioctl)

;; -- Network fully allowed here; the jail overlay locks egress when enabled --
(allow network*)

;; -- Reads: allow globally, make HOME opaque, then re-grant a minimal set --
(allow file-read*)
(deny file-read* (subpath (param "_HOME")))
(allow file-read* (subpath (param "_PROJECT_DIR")))
(allow file-read* (subpath (string-append (param "_HOME") "/.claude")))
(allow file-read* (literal (string-append (param "_HOME") "/.claude.json")))
;; claude keeps one directory of session JSONL per workspace, and a workspace is
;; one chat thread. The grant above reaches all of them, so a jailed turn could
;; read the verbatim turns of every other thread on the host. Deny the tree and
;; re-grant only the running thread's directory, which is what the CLI needs to
;; write and resume its own session. Both params are resolved per run from the
;; workspace, so _CLAUDE_PROJECT is always a child of _CLAUDE_PROJECTS and wins
;; by depth. Parameterised rather than built from _HOME because CLAUDE_CONFIG_DIR
;; can move the tree anywhere, including outside $HOME where the deny above it
;; would not reach.
;; read the verbatim turns of every other thread on the host. The pair that does
;; it is at the END of this section, not here: see "Cross-thread session stores"
;; below. It has to come after the operator and runtime allows, because either one
;; can name an ancestor of these trees.
;; codex config, the same grant ~/.claude gets for the other backend.
(allow file-read* (subpath (string-append (param "_HOME") "/.codex")))
;; Command-broker shims. Generated under DATA_DIR, which deny-most makes
;; opaque along with the rest of $HOME, so grant it back or every shimmed
;; tool becomes "command not found".
(allow file-read* (subpath (string-append (param "_DATA_DIR") "/shims")))
;; The agent's persistent memory, which the system prompt has it read every turn.
;; It lives outside the workspace, so deny-most makes it opaque along with the
;; rest of $HOME unless it is granted back. Scoped to memory/ so the sibling .env
;; and logs/ stay unreadable.
(allow file-read* (subpath (string-append (param "_DATA_DIR") "/memory")))
;; The agent's own uv cache. Written by it, so it has to be readable back, and it
;; lives under the data dir this profile makes opaque. See the write grant below
;; for why it is not the operator's cache.
(allow file-read* (subpath (string-append (param "_DATA_DIR") "/uv-cache")))
;; The operator's cache, read-only. uv is pointed elsewhere for writes, and a
;; downloaded wheel is not a secret, so reading a warm cache costs nothing.
(allow file-read* (subpath (string-append (param "_HOME") "/.cache/uv")))
(allow file-read* (subpath (param "_TMPDIR")))
;; The runtime this jail has to be able to run: the agent binary's directory and
;; the interpreter behind it. Both routinely live under $HOME -- an npm global in
;; ~/.local/bin, a uv virtualenv beside the project -- and this profile makes $HOME
;; opaque, so without these the backend cannot be exec'd at all. Measured: a
;; backend under ~/.local/bin exits 126 and `sandbox-exec` refuses the venv
;; interpreter with "execvp() ... Operation not permitted" (rc 71), which is how
;; the startup egress probe came to block the daemon entirely.
;;
;; Five slots because SBPL has no arrays, same trade as _EXTRA_*. Unused slots
;; repeat _PROJECT_DIR, which is already allowed. Five rather than four because a
;; launcher and the code it runs need not share a directory: `claude` installs as
;; a symlink in ~/.local/bin pointing into ~/.local/share/claude/versions/<v>, and
;; granting only the resolved parent left execvp unable to read the symlink it has
;; to resolve first (rc 71, "No such file or directory", which reads like a missing
;; binary rather than a denial).
(allow file-read* (subpath (param "_RUNTIME_1")))
(allow file-read* (subpath (param "_RUNTIME_2")))
(allow file-read* (subpath (param "_RUNTIME_3")))
(allow file-read* (subpath (param "_RUNTIME_4")))
(allow file-read* (subpath (param "_RUNTIME_5")))
;; Operator grants (COTF_SANDBOX_EXTRA_PATHS, capped at 3). Unused slots point
;; at _PROJECT_DIR, already allowed above, so they add nothing.
(allow file-read* (subpath (param "_EXTRA_1")))
(allow file-read* (subpath (param "_EXTRA_2")))
(allow file-read* (subpath (param "_EXTRA_3")))
;; -- Cross-thread session stores --
;; Placed here, after every allow above, for the reason the _DATA_DIR denies below
;; are placed last: SBPL is last-match-wins, and an operator grant or a runtime
;; grant can name an ancestor of these trees. Measured with these two pairs in the
;; read section above the _EXTRA_* allows: one `sandbox.extra_paths` entry of $HOME
;; made another thread's codex rollout and another thread's claude session both
;; readable again, while the profile still loaded and the log still said jailed.
;; `sandbox.extra_paths` is also the remedy the agent is told to relay when a read
;; is blocked, so that entry is a thing an operator is actively invited to add.
;;
;; Each pair is deny-the-tree then re-grant-this-thread, and the order inside a
;; pair is load-bearing too. _CLAUDE_PROJECT is always a child of
;; _CLAUDE_PROJECTS, so it wins by depth as well as by position.
(deny file-read* (subpath (param "_CLAUDE_PROJECTS")))
(allow file-read* (subpath (param "_CLAUDE_PROJECT")))
;; Every prompt typed in every project on this host, so it crosses threads the same
;; way projects/ does. Denied by name, like the credentials further down, because it
;; is one file rather than a tree. No measured turn writes it, so nothing is lost.
(deny file-read* (literal (string-append (param "_CLAUDE_CONFIG") "/history.jsonl")))
;; codex was the wider hole: the ~/.codex allow above reached every rollout in one
;; flat date tree, 1088 of them on the host this was measured on. codex picks the
;; rollout name at startup, so there is no per-workspace path to re-grant inside
;; the shared tree; the workspace gets its own CODEX_HOME instead and this thread's
;; rollouts are the only ones in it. _CODEX_HOME lives under the data dir, which
;; this profile makes opaque, so it needs its own grant to be reachable at all.
;; Measured with this pair placed before the ~/.codex allow, that allow won and a
;; jailed turn still read 91855 bytes of another thread's rollout.
(deny file-read* (subpath (param "_CODEX_SESSIONS")))
(allow file-read* (subpath (param "_CODEX_HOME")))
;; The daemon's own .env and logs stay denied even outside _HOME: deny-most only
;; makes $HOME opaque, and COTF_DATA_DIR can point the data dir anywhere -- at a
;; redirected directory outside $HOME every rule above would leave the tokens
;; readable. Same shape as fs-allow-reads.sb's rules, so a redirected daemon gets
;; the same boundary in both profiles. Last in this section so they win over the
;; _TMPDIR / _EXTRA_* allows above if the data dir ever sits under those.
(deny file-read* (regex (string-append "^" (regex-quote (param "_DATA_DIR")) "/(.*/)?\\.env")))
(deny file-read* (subpath (string-append (param "_DATA_DIR") "/logs")))

;; -- Writes: identical allowlist to fs-allow-reads.sb --
;; Global Claude settings/hooks/plugins are read by future invocations, so a
;; sandboxed turn must not persist instructions there. The deny is explicit even
;; though deny-most already denies HOME, keeping the policy invariant visible.
(deny file-write* (subpath (string-append (param "_HOME") "/.claude")))
;; The same deny against the resolved config directory, because CLAUDE_CONFIG_DIR
;; can move it outside $HOME where the rule above reaches nothing. Every claude
;; re-grant below is written against this param for the same reason.
(deny file-write* (subpath (param "_CLAUDE_CONFIG")))
(allow file-write* (literal (string-append (param "_HOME") "/.claude.json")))
(allow file-write* (literal (string-append (param "_CLAUDE_CONFIG") "/.claude.json")))
;; The denies above cover projects/, where the claude CLI writes the session JSONL
;; that makes resume work, and its per-project memory directory. The CLI is the
;; jailed process, so it was denied both. Turns still completed, which is why this
;; went unnoticed: the failure is silent and only a resume or a lost memory shows
;; it. Re-granted for the running thread alone, so a turn still cannot reach
;; another thread's conversation or memory.
(allow file-write* (subpath (param "_CLAUDE_PROJECT")))
;; Runtime scratch a real turn was measured writing. See _CLAUDE_RUNTIME_WRITES in
;; sandbox.py for how the list was taken and why each entry is not
;; instruction-bearing. settings.json, hooks, commands, skills, agents and the
;; plugins/ root are absent on purpose and stay denied by the rules above.
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/shell-snapshots")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/session-env")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/sessions")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/plugins/cache")))
(allow file-write* (literal (string-append (param "_CLAUDE_CONFIG") "/policy-limits.json")))
;; codex needs this to start at all; see the note in fs-allow-reads.sb.
;; codex needs to write under ~/.codex or it will not start, but the directory also
;; holds everything that decides what codex *executes* and what it is *told*. So this
;; is deny-default with an explicit re-grant, rather than a grant with a denylist of
;; the dangerous files.
;;
;; The old denylist was already incomplete: hooks.json, config.toml and rules/ were
;; denied while plugins/, history.jsonl and AGENTS.md stayed writable -- and AGENTS.md
;; is standing instructions codex reads on every later run, so an injected agent could
;; leave itself orders that outlive the session. Enumerating dangerous files means
;; losing that race every time codex adds one; the explicit grants above avoid it.
;;
;; The grants below are measured, not guessed: they are what a real `codex exec` turn
;; touched under this directory. Two of them are execution-adjacent and cannot be
;; closed, which is a known limit rather than an oversight:
;;   shell_snapshots/  a shell script codex writes and then sources
;;   plugins/cache/    plugin payloads, scoped to cache/ and the staging dir so a
;;                     manifest at the plugins/ root stays denied
(deny file-write* (subpath (string-append (param "_HOME") "/.codex")))
;; Rollouts go to this thread's own CODEX_HOME now, so the shared tree no longer
;; needs to be writable. Everything codex writes that is not a rollout -- the
;; sqlite state, the caches, the shell snapshot it sources, the writer lock --
;; lands inside _CODEX_HOME, which the grant below covers wholesale.
(allow file-write* (subpath (param "_CODEX_HOME")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/tmp")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/cache")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/log")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/shell_snapshots")))
;; Per-thread writer lock directory, added by a codex release after this list
;; was measured. Without it codex 0.147 exits before any network call with
;; "Operation not permitted": it cannot create the coordination lock and so
;; cannot initialise thread persistence, which is what session resume needs.
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/thread-writer-locks")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/plugins/cache")))
(allow file-write*
  (subpath (string-append (param "_HOME") "/.codex/plugins/.remote-plugin-install-staging")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/models_cache.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/version.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/installation_id")))
;; The agent's own OAuth credential. Denying the *write* protects nothing: the read
;; is already permitted by design (see "Deliberately NOT denied" above), so an agent
;; that wanted the token already has it. What denying would cost is token refresh --
;; codex persists a refreshed ChatGPT token here, and a deployment that cannot would
;; break the first time one expired.
(allow file-write* (literal (string-append (param "_HOME") "/.codex/auth.json")))
;; The sqlite state files, plus the -wal/-shm siblings each one opens alongside it.
(allow file-write*
  (regex (string-append "^" (regex-quote (param "_HOME")) "/\\.codex/[^/]*\\.sqlite(-wal|-shm)?$")))
;; The agent's own uv cache, not the operator's: `upgrade.run` runs `uv sync`
;; outside any jail with the TUI's full environment, so a wheel a jailed turn
;; seeded in ~/.cache/uv is code the operator later runs on purpose. See
;; sandbox.uv_cache_dir, which agent_env exports as UV_CACHE_DIR. The read allow
;; on ~/.cache/uv above is kept: reading a warm cache leaks nothing.
(allow file-write* (subpath (string-append (param "_DATA_DIR") "/uv-cache")))
(allow file-write* (subpath (string-append (param "_HOME") "/.ollama")))
(allow file-write* (subpath (string-append (param "_HOME") "/.Trash")))
(allow file-write* (subpath (string-append (param "_DATA_DIR") "/memory")))
(allow file-write* (subpath (param "_PROJECT_DIR")))
(allow file-write* (subpath (param "_TMPDIR")))
(allow file-write* (subpath "/private/var/folders/"))
(allow file-write* (subpath "/private/tmp/"))
(allow file-write* (subpath "/dev/"))

;; -- Mandatory write denies within allowed areas (mirrors fs-allow-reads.sb) --
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.git/hooks")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.git/config")))
;; Shell and git config inside the workspace. Denied by fs-allow-reads.sb but
;; not here until a cross-platform parity test ran both profiles against the
;; same contract: the least-privilege profile was the more permissive of the
;; two for these three paths, which is the opposite of what its name promises.
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.bashrc")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.zshrc")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.gitconfig")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.mcp.json")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.vscode")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.idea")))
