;; fs-deny-most.sb: least-privilege filesystem base (COTF_SANDBOX_FS=deny-most).
;;
;; Derived from agent-seatbelt's my.deny-most.sb. Keep the rule order and
;; structure aligned with upstream so its changes stay diffable.
;;
;; Same shape as fs-allow-reads.sb, but the home directory is opaque by default. Where fs-allow-reads.sb
;; does a global (allow file-read*) with a secret denylist, this denies every
;; read under _HOME and then re-grants only what the agent needs, plus up to
;; three operator-named paths (_EXTRA_1.._EXTRA_3, from COTF_SANDBOX_EXTRA_PATHS).
;; Reads outside _HOME (system libraries, the toolchain) stay allowed so the
;; binaries the agent runs still start.
;;
;; This is coarser than fs-allow-reads.sb by design: an agent that reads dotfiles outside
;; the re-granted set (e.g. ~/.gitconfig, ~/.npmrc) will be denied. Grant those
;; explicitly via COTF_SANDBOX_EXTRA_PATHS if a run needs them.
;;
;; cotf's own data-dir re-grants (shims/ and memory/) are scoped to _DATA_DIR,
;; which the wrapper resolves from the daemon's data directory (COTF_DATA_DIR
;; when redirected). Only the daemon's own shims and memory are re-granted: a
;; redirected daemon's data dir lives under _HOME and stays opaque like the rest.
;;
;; Parameters (injected by the wrapper): _HOME, _DATA_DIR, _PROJECT_DIR, _TMPDIR,
;; and _EXTRA_1.._EXTRA_3 (unused slots resolve to _PROJECT_DIR, a harmless no-op).

(version 1)
(deny default)

;; -- Process & system essentials (mirrors fs-allow-reads.sb) --
(allow process-exec)
(allow process-fork)
(allow process-info*)
(allow signal)
(allow mach*)
(allow sysctl*)
(allow ipc-posix-shm*)
(allow ipc-posix-sem*)
(allow iokit-open)
(allow system-socket)
(allow system-fsctl)
(allow pseudo-tty)
(allow user-preference-read)
(allow file-ioctl)

;; -- Network fully allowed here; the jail overlay locks egress when enabled --
(allow network*)

;; -- Reads: allow globally, make HOME opaque, then re-grant a minimal set --
(allow file-read*)
(deny file-read* (subpath (param "_HOME")))
(allow file-read* (subpath (param "_PROJECT_DIR")))
(allow file-read* (subpath (string-append (param "_HOME") "/.claude")))
(allow file-read* (literal (string-append (param "_HOME") "/.claude.json")))
;; codex config, the same grant ~/.claude gets for the other backend.
(allow file-read* (subpath (string-append (param "_HOME") "/.codex")))
;; Command-broker shims. Generated under DATA_DIR, which deny-most makes
;; opaque along with the rest of $HOME, so grant it back or every shimmed
;; tool becomes "command not found".
(allow file-read* (subpath (string-append (param "_DATA_DIR") "/shims")))
;; The agent's persistent memory, which the system prompt has it read every turn.
;; It lives outside the workspace, so deny-most makes it opaque along with the
;; rest of $HOME unless it is granted back. Scoped to memory/ so the sibling .env
;; and logs/ stay unreadable.
(allow file-read* (subpath (string-append (param "_DATA_DIR") "/memory")))
(allow file-read* (subpath (string-append (param "_HOME") "/.cache/uv")))
(allow file-read* (subpath (param "_TMPDIR")))
;; Operator grants (COTF_SANDBOX_EXTRA_PATHS, capped at 3). Unused slots point
;; at _PROJECT_DIR, already allowed above, so they add nothing.
(allow file-read* (subpath (param "_EXTRA_1")))
(allow file-read* (subpath (param "_EXTRA_2")))
(allow file-read* (subpath (param "_EXTRA_3")))
;; The daemon's own .env and logs stay denied even outside _HOME: deny-most only
;; makes $HOME opaque, and COTF_DATA_DIR can point the data dir anywhere -- at a
;; redirected directory outside $HOME every rule above would leave the tokens
;; readable. Same shape as fs-allow-reads.sb's rules, so a redirected daemon gets
;; the same boundary in both profiles. Last in this section so they win over the
;; _TMPDIR / _EXTRA_* allows above if the data dir ever sits under those.
(deny file-read* (regex (string-append "^" (regex-quote (param "_DATA_DIR")) "/(.*/)?\\.env")))
(deny file-read* (subpath (string-append (param "_DATA_DIR") "/logs")))

;; -- Writes: identical allowlist to fs-allow-reads.sb --
;; Global Claude settings/hooks/plugins are read by future invocations, so a
;; sandboxed turn must not persist instructions there. The deny is explicit even
;; though deny-most already denies HOME, keeping the policy invariant visible.
(deny file-write* (subpath (string-append (param "_HOME") "/.claude")))
(allow file-write* (literal (string-append (param "_HOME") "/.claude.json")))
;; codex needs this to start at all; see the note in fs-allow-reads.sb.
;; codex needs to write under ~/.codex or it will not start, but the directory also
;; holds everything that decides what codex *executes* and what it is *told*. So this
;; is deny-default with an explicit re-grant, rather than a grant with a denylist of
;; the dangerous files.
;;
;; The old denylist was already incomplete: hooks.json, config.toml and rules/ were
;; denied while plugins/, history.jsonl and AGENTS.md stayed writable -- and AGENTS.md
;; is standing instructions codex reads on every later run, so an injected agent could
;; leave itself orders that outlive the session. Enumerating dangerous files means
;; losing that race every time codex adds one; the explicit grants above avoid it.
;;
;; The grants below are measured, not guessed: they are what a real `codex exec` turn
;; touched under this directory. Two of them are execution-adjacent and cannot be
;; closed, which is a known limit rather than an oversight:
;;   shell_snapshots/  a shell script codex writes and then sources
;;   plugins/cache/    plugin payloads, scoped to cache/ and the staging dir so a
;;                     manifest at the plugins/ root stays denied
(deny file-write* (subpath (string-append (param "_HOME") "/.codex")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/sessions")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/tmp")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/cache")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/log")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/shell_snapshots")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/plugins/cache")))
(allow file-write*
  (subpath (string-append (param "_HOME") "/.codex/plugins/.remote-plugin-install-staging")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/models_cache.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/version.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/installation_id")))
;; The agent's own OAuth credential. Denying the *write* protects nothing: the read
;; is already permitted by design (see "Deliberately NOT denied" above), so an agent
;; that wanted the token already has it. What denying would cost is token refresh --
;; codex persists a refreshed ChatGPT token here, and a deployment that cannot would
;; break the first time one expired.
(allow file-write* (literal (string-append (param "_HOME") "/.codex/auth.json")))
;; The sqlite state files, plus the -wal/-shm siblings each one opens alongside it.
(allow file-write*
  (regex (string-append "^" (regex-quote (param "_HOME")) "/\\.codex/[^/]*\\.sqlite(-wal|-shm)?$")))
(allow file-write* (subpath (string-append (param "_HOME") "/.cache/uv")))
(allow file-write* (subpath (string-append (param "_HOME") "/.ollama")))
(allow file-write* (subpath (string-append (param "_HOME") "/.Trash")))
(allow file-write* (subpath (string-append (param "_DATA_DIR") "/memory")))
(allow file-write* (subpath (param "_PROJECT_DIR")))
(allow file-write* (subpath (param "_TMPDIR")))
(allow file-write* (subpath "/private/var/folders/"))
(allow file-write* (subpath "/private/tmp/"))
(allow file-write* (subpath "/dev/"))

;; -- Mandatory write denies within allowed areas (mirrors fs-allow-reads.sb) --
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.git/hooks")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.git/config")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.mcp.json")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.vscode")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.idea")))
