;; fs-allow-reads.sb: the default filesystem base, imported by jail.sb.
;;
;; Derived from agent-seatbelt's my.sb. Keep the rule order and structure
;; aligned with upstream so its changes stay diffable against this file.
;;
;; Policy: deny-default → allow reads globally → deny reads on secrets → allowlist writes only
;;
;; Parameters (injected by wrapper):
;;   _HOME        — user home directory
;;   _DATA_DIR    — daemon data directory (COTF_DATA_DIR when redirected)
;;   _PROJECT_DIR — resolved project working directory
;;   _TMPDIR      — macOS per-user temp directory
;;   _CLAUDE_PROJECTS — claude's session store root (denied)
;;   _CLAUDE_PROJECT  — the running thread's session directory inside it (granted)

(version 1)
(deny default)

;; ---------------------------------------------------------------------------
;; Process & system essentials
;; ---------------------------------------------------------------------------
(allow process-exec)
(allow process-fork)
(allow process-info*)
(allow signal)
(allow mach*)
(allow sysctl*)
(allow ipc-posix-shm*)
(allow ipc-posix-sem*)
(allow iokit-open)
(allow system-socket)
(allow system-fsctl)
(allow pseudo-tty)
(allow user-preference-read)
(allow file-ioctl)

;; ---------------------------------------------------------------------------
;; Network — fully allowed
;; ---------------------------------------------------------------------------
(allow network*)

;; ---------------------------------------------------------------------------
;; Read access — global allow, then deny secrets
;; ---------------------------------------------------------------------------
(allow file-read*)

;; -- Cryptographic keys --
;; Allows ssh config, known_hosts, and public keys; blocks private keys.
(deny file-read*
  (require-all
    (subpath (string-append (param "_HOME") "/.ssh"))
    (require-not (literal (string-append (param "_HOME") "/.ssh/config")))
    (require-not (literal (string-append (param "_HOME") "/.ssh/known_hosts")))
    (require-not (literal (string-append (param "_HOME") "/.ssh/known_hosts.old")))
    (require-not (regex (string-append "^" (regex-quote (param "_HOME")) "/\\.ssh/.*\\.pub$")))
  ))

(deny file-read* (subpath (string-append (param "_HOME") "/.gnupg")))

;; -- Cloud providers (Reasonable Access) --
;; Allow reading configs (profiles/regions) but deny credentials.
(deny file-read*
  (require-all
    (subpath (string-append (param "_HOME") "/.aws"))
    (require-not (literal (string-append (param "_HOME") "/.aws/config")))
  ))
(deny file-read* (literal (string-append (param "_HOME") "/.aws/credentials")))

;; -- Container & orchestration --
(deny file-read* (subpath (string-append (param "_HOME") "/.docker")))
(deny file-read* (subpath (string-append (param "_HOME") "/.kube")))

;; -- Credentials of brokered CLIs --
;; These are denied because the agent does not need them: it reaches the tool
;; through a shim that forwards to the command broker outside the sandbox, which
;; holds the credential (commands.py). Denying the file used to cost the whole
;; capability, which is why an earlier revision granted ~/.config/gh; with a shim
;; the deny is free.
;;
;; A credential denied here without a matching shim breaks that tool under `jail`.
;; That is the deliberate order: deny first, shim as each tool is added. `gh` is
;; shimmed today; the rest are listed below and are currently unavailable under
;; `jail` by choice.
(deny file-read* (subpath (string-append (param "_HOME") "/.config/gh")))

;; -- Credentials with no shim yet (tool unavailable under jail) --
;; Adopted after the original denylist was written, so they were readable by
;; default until a probe caught it. An enumerate-the-bad list goes stale exactly
;; this way; each addition here should come with a SHIMMED_TOOLS entry.
(deny file-read* (subpath (string-append (param "_HOME") "/.config/acli")))
(deny file-read* (subpath (string-append (param "_HOME") "/.local/share/acli")))
(deny file-read* (subpath (string-append (param "_HOME") "/.config/gws")))
(deny file-read* (subpath (string-append (param "_HOME") "/.config/gcloud")))
(deny file-read* (literal (string-append (param "_HOME") "/.sentryclirc")))

;; -- Package manager and build tokens --
(deny file-read* (literal (string-append (param "_HOME") "/.pypirc")))
(deny file-read* (literal (string-append (param "_HOME") "/.npmrc")))
(deny file-read* (literal (string-append (param "_HOME") "/.cargo/credentials.toml")))
(deny file-read* (literal (string-append (param "_HOME") "/.netrc")))
(deny file-read* (literal (string-append (param "_HOME") "/.gem/credentials")))
(deny file-read* (literal (string-append (param "_HOME") "/.config/pip/pip.conf")))
(deny file-read* (literal (string-append (param "_HOME") "/.m2/settings.xml")))
(deny file-read* (literal (string-append (param "_HOME") "/.gradle/gradle.properties")))

;; -- Stores not present on the machine this list was written on --
;; Denied ahead of need, because the failure mode of this list is a store that
;; nobody thought about being readable by default on someone else's machine. A
;; deny for an absent path costs nothing; the same deny added after the fact
;; costs whatever the agent read in between. As above, denying one makes its CLI
;; unusable under jail until it earns a SHIMMED_TOOLS entry.

;; Remaining clouds (aws/gcloud handled above).
(deny file-read* (subpath (string-append (param "_HOME") "/.azure")))
(deny file-read* (literal (string-append (param "_HOME") "/.oci/config")))

;; Forges and plaintext git credentials. ~/.gitconfig stays readable on purpose
;; (git needs it, and the agent is told it may read it), so a credential helper
;; configured there is a deliberate remaining exposure.
(deny file-read* (literal (string-append (param "_HOME") "/.git-credentials")))
(deny file-read* (subpath (string-append (param "_HOME") "/.config/glab-cli")))
(deny file-read* (literal (string-append (param "_HOME") "/.config/hub")))

;; Container registries beyond docker.
(deny file-read* (literal (string-append (param "_HOME") "/.config/containers/auth.json")))

;; Infrastructure and secret managers.
(deny file-read* (literal (string-append (param "_HOME") "/.terraform.d/credentials.tfrc.json")))
(deny file-read* (literal (string-append (param "_HOME") "/.vault-token")))
(deny file-read* (subpath (string-append (param "_HOME") "/.config/1Password")))
(deny file-read* (subpath (string-append (param "_HOME") "/.op")))

;; Data warehouses and databases. Credentials sit in the same file as the config
;; for all of these, so unlike aws there is no config/credential split to keep.
(deny file-read* (subpath (string-append (param "_HOME") "/.snowflake")))
(deny file-read* (subpath (string-append (param "_HOME") "/.snowsql")))
(deny file-read* (literal (string-append (param "_HOME") "/.databrickscfg")))
(deny file-read* (literal (string-append (param "_HOME") "/.pgpass")))
(deny file-read* (literal (string-append (param "_HOME") "/.my.cnf")))

;; Object storage and sync tools.
(deny file-read* (literal (string-append (param "_HOME") "/.config/rclone/rclone.conf")))
(deny file-read* (literal (string-append (param "_HOME") "/.s3cfg")))
(deny file-read* (literal (string-append (param "_HOME") "/.boto")))

;; PaaS deploy tokens: each of these can push code straight to production.
(deny file-read* (subpath (string-append (param "_HOME") "/.wrangler")))
(deny file-read* (subpath (string-append (param "_HOME") "/.vercel")))
(deny file-read* (subpath (string-append (param "_HOME") "/.config/netlify")))
(deny file-read* (subpath (string-append (param "_HOME") "/.fly")))
(deny file-read* (subpath (string-append (param "_HOME") "/.heroku")))

;; -- Deliberately NOT denied: the agent's own credential --
;; ~/.codex/auth.json and ~/.claude/.credentials.json hold the backend's own
;; OAuth tokens, and the agent process must read them to authenticate. Verified:
;; denying ~/.codex/auth.json makes codex exit with "Operation not permitted"
;; before it makes any network call. A jailed agent can therefore always read the
;; credential it runs on, and a hijacked one can exfiltrate it through the
;; already-approved model host. This is structural, not an oversight; see
;; "The architectural limit" in docs/agent/broker.md.

;; -- Privacy & Secrets --
;; Simplified history block using regex
(deny file-read* (regex (string-append "^" (regex-quote (param "_HOME")) "/\\..*_history$")))
(deny file-read* (literal (string-append (param "_HOME") "/.env")))

;; -- This daemon's own secrets --
;; The whole point of env curation is that SLACK_TOKEN / TELEGRAM_BOT_TOKEN never
;; reach the agent. Leaving the file that holds them readable defeats that
;; entirely, and it was readable: a jailed agent could list every var in it. With
;; the Slack user token a hijacked agent could also post as the operator, which
;; means clicking its own approval buttons -- the approval gate re-checks the
;; sender, and the sender would have been legitimate.
;;
;; Scoped to the secrets rather than the whole directory, because the agent's
;; workspace (workspaces/) and its memory (memory/) live under here too and are
;; meant to be reachable, and shims/ must stay executable.
;;
;; `.env` is matched at ANY depth under the directory, not just at its root. The
;; root-only form left a copy one level down readable, which is not hypothetical: a
;; backup taken before editing the file lands in exactly that shape, and so does
;; anything a syncer drops beside it (`.env.sync-conflict-...`). A deny list that
;; covers the canonical path and not its neighbours protects the file an operator
;; thinks about and misses the ones they do not.
;;
;; Each rule is dual-scoped: the default `~/.claude-on-the-fly` location stays
;; denied even when this daemon runs on a redirected data dir (COTF_DATA_DIR),
;; because the default directory then holds *another daemon's* tokens and
;; conversation logs. The _DATA_DIR rules cover the redirected directory itself.
(deny file-read* (regex (string-append "^" (regex-quote (param "_HOME")) "/\\.claude-on-the-fly/(.*/)?\\.env")))
(deny file-read* (regex (string-append "^" (regex-quote (param "_DATA_DIR")) "/(.*/)?\\.env")))
(deny file-read* (subpath (string-append (param "_HOME") "/.claude-on-the-fly/logs")))
(deny file-read* (subpath (string-append (param "_DATA_DIR") "/logs")))
;; The daemons' own bookkeeping: heartbeats, pids, the event log, the Telegram
;; session map, and the pending-turn journal. None of it is the agent's business,
;; and two parts of it are worse than merely private. The journal's entries are
;; replayed as user messages at the next start, so a writable journal is a prompt
;; the agent could schedule for itself past any approval the operator set; and
;; the session map plus the event log describe every other conversation this
;; daemon serves, which is the boundary `sandbox.scope_sessions` exists to hold.
;; Denied in both directions and probed at startup (`sandbox._DENY_PROBES`),
;; because a rule nobody tests is a rule that can be narrowed in silence.
;; The write half of this pair is at the end of the write section, not here: it
;; has to come after `_PROJECT_DIR`, which is granted writes and is a path built
;; from a name a frontend supplies.
(deny file-read* (subpath (string-append (param "_HOME") "/.claude-on-the-fly/state")))
(deny file-read* (subpath (string-append (param "_DATA_DIR") "/state")))
(deny file-read* (literal (string-append (param "_HOME") "/.zhistory")))
(deny file-read* (subpath (string-append (param "_HOME") "/.zsh")))

;; -- Other threads' conversations --
;; claude keeps one directory of session JSONL per workspace, and a workspace is
;; one chat thread. Reads are global in this profile, so without these two rules a
;; jailed turn could read the verbatim turns of every other thread on the host,
;; including message bodies from other senders. Sharper in kind than the secrets
;; denied above: those are credentials, this is the conversation itself.
;;
;; The re-grant is the running thread's own directory, which the CLI needs because
;; it is the jailed process and writes its own session file. Parameterised rather
;; than built from _HOME because CLAUDE_CONFIG_DIR can move the tree outside $HOME.
(deny file-read* (subpath (param "_CLAUDE_PROJECTS")))
(allow file-read* (subpath (param "_CLAUDE_PROJECT")))
;; Every prompt typed in every project on this host, so it crosses threads the same
;; way projects/ does. Denied by name, like the credentials above, because it is one
;; file rather than a tree. No measured turn writes it, so nothing is lost.
(deny file-read* (literal (string-append (param "_CLAUDE_CONFIG") "/history.jsonl")))
;; codex, same boundary and the wider hole of the two: its rollouts sit in one flat
;; date tree that the global read allow reached in full, 1088 files on the host this
;; was measured on. codex chooses the rollout name at startup, so there is nothing
;; per-workspace to re-grant inside the shared tree; the workspace gets its own
;; CODEX_HOME and only its own rollouts are in it.
(deny file-read* (subpath (param "_CODEX_SESSIONS")))
(allow file-read* (subpath (param "_CODEX_HOME")))

;; -- macOS Sensitive Data --
;; Allowed to enable macOS Security framework (Keychain) for tool authentication (e.g., Claude login)
(allow file-read* (subpath (string-append (param "_HOME") "/Library/Keychains")))
(deny file-read* (subpath (string-append (param "_HOME") "/Library/Safari")))

;; -- Browser profiles --
(deny file-read* (subpath (string-append (param "_HOME") "/Library/Application Support/Google/Chrome")))
(deny file-read* (subpath (string-append (param "_HOME") "/Library/Application Support/Zen")))

;; ---------------------------------------------------------------------------
;; Write access — deny-default, explicit allowlist only
;; ---------------------------------------------------------------------------
;; Claude's global config contains settings, hooks, commands, and plugins that
;; the agent reads on later invocations. Do not let an untrusted turn persist
;; instructions there. Claude can still read its config; global config changes are
;; an operator action.
;;
;; Its session state does NOT live in the workspace, which this comment used to
;; claim. It lives in `projects/<workspace hash>/` under the config directory, so
;; the deny below covered the one file resume depends on, and the CLI is the jailed
;; process that writes it. The re-grant is that directory for the running thread
;; only, so persistence works without reopening the other threads.
(deny file-write* (subpath (string-append (param "_HOME") "/.claude")))
;; The same deny against the resolved config directory, because CLAUDE_CONFIG_DIR
;; can move it outside $HOME where the rule above reaches nothing. Every claude
;; re-grant below is written against this param for the same reason.
(deny file-write* (subpath (param "_CLAUDE_CONFIG")))
(allow file-write* (literal (string-append (param "_HOME") "/.claude.json")))
(allow file-write* (literal (string-append (param "_CLAUDE_CONFIG") "/.claude.json")))
(allow file-write* (subpath (param "_CLAUDE_PROJECT")))
;; Runtime scratch a real turn was measured writing. See _CLAUDE_RUNTIME_WRITES in
;; sandbox.py for how the list was taken and why each entry is not
;; instruction-bearing. settings.json, hooks, commands, skills, agents and the
;; plugins/ root are absent on purpose and stay denied by the rules above.
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/shell-snapshots")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/session-env")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/sessions")))
(allow file-write* (subpath (string-append (param "_CLAUDE_CONFIG") "/plugins/cache")))
(allow file-write* (literal (string-append (param "_CLAUDE_CONFIG") "/policy-limits.json")))
;; codex: the same grant ~/.claude gets, for the other backend. Without it codex
;; dies at startup with "failed to initialize in-process app-server client:
;; Operation not permitted" before it makes any network call, because its
;; app-server and PATH aliases live under ~/.codex. Verified: adding this one
;; line is the whole difference between codex failing and running under the jail.
;; codex needs to write under ~/.codex or it will not start, but the directory also
;; holds everything that decides what codex *executes* and what it is *told*. So this
;; is deny-default with an explicit re-grant, rather than a grant with a denylist of
;; the dangerous files.
;;
;; The old denylist was already incomplete: hooks.json, config.toml and rules/ were
;; denied while plugins/, history.jsonl and AGENTS.md stayed writable -- and AGENTS.md
;; is standing instructions codex reads on every later run, so an injected agent could
;; leave itself orders that outlive the session. Enumerating dangerous files means
;; losing that race every time codex adds one; the explicit grants above avoid it.
;;
;; The grants below are measured, not guessed: they are what a real `codex exec` turn
;; touched under this directory. Two of them are execution-adjacent and cannot be
;; closed, which is a known limit rather than an oversight:
;;   shell_snapshots/  a shell script codex writes and then sources
;;   plugins/cache/    plugin payloads, scoped to cache/ and the staging dir so a
;;                     manifest at the plugins/ root stays denied
(deny file-write* (subpath (string-append (param "_HOME") "/.codex")))
;; Rollouts land in this thread's own CODEX_HOME now, so the shared tree stops
;; being writable. Deliberately fail-closed: if the redirect ever did not reach the
;; child, codex would write here and then be refused the read back, and a resume
;; that silently forgets the conversation is the failure this whole change exists
;; to remove. Denied both ways, it fails at startup instead.
(allow file-write* (subpath (param "_CODEX_HOME")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/tmp")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/cache")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/log")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/shell_snapshots")))
;; Per-thread writer lock directory, added by a codex release after this list
;; was measured. Without it codex 0.147 exits before any network call with
;; "Operation not permitted": it cannot create the coordination lock and so
;; cannot initialise thread persistence, which is what session resume needs.
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/thread-writer-locks")))
(allow file-write* (subpath (string-append (param "_HOME") "/.codex/plugins/cache")))
(allow file-write*
  (subpath (string-append (param "_HOME") "/.codex/plugins/.remote-plugin-install-staging")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/models_cache.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/version.json")))
(allow file-write* (literal (string-append (param "_HOME") "/.codex/installation_id")))
;; The agent's own OAuth credential. Denying the *write* protects nothing: the read
;; is already permitted by design (see "Deliberately NOT denied" above), so an agent
;; that wanted the token already has it. What denying would cost is token refresh --
;; codex persists a refreshed ChatGPT token here, and a deployment that cannot would
;; break the first time one expired.
(allow file-write* (literal (string-append (param "_HOME") "/.codex/auth.json")))
;; The sqlite state files, plus the -wal/-shm siblings each one opens alongside it.
(allow file-write*
  (regex (string-append "^" (regex-quote (param "_HOME")) "/\\.codex/[^/]*\\.sqlite(-wal|-shm)?$")))
;; uv: Needed for caching packages and metadata
(allow file-write* (subpath (string-append (param "_HOME") "/.cache/uv")))
;; Ollama: Needed to sync aliases, save configurations, and manage models/temporary files
(allow file-write* (subpath (string-append (param "_HOME") "/.ollama")))
(allow file-write* (subpath (string-append (param "_HOME") "/.Trash")))
;; The agent's persistent memory. The system prompt tells it to update
;; memory/users/<sender>/*.md and memory/knowledge/*.md every turn, and that path
;; is outside the workspace, so without this every memory write fails with
;; "Operation not permitted" and the feature is silently off under `jail`.
;; Scoped to memory/ on purpose: the sibling .env and logs/ stay unreadable.
;; Resolved from _DATA_DIR so a redirected data dir keeps its own memory writable.
(allow file-write* (subpath (string-append (param "_DATA_DIR") "/memory")))
(allow file-write* (subpath (param "_PROJECT_DIR")))
(allow file-write* (subpath (param "_TMPDIR")))
(allow file-write* (subpath "/private/var/folders/"))
(allow file-write* (subpath "/private/tmp/"))
(allow file-write* (subpath "/dev/"))

;; ---------------------------------------------------------------------------
;; Mandatory write denies — defense-in-depth (HOME)
;; ---------------------------------------------------------------------------
(deny file-write* (subpath (string-append (param "_HOME") "/.ssh")))
(deny file-write* (subpath (string-append (param "_HOME") "/.gnupg")))
(deny file-write* (literal (string-append (param "_HOME") "/.gitconfig")))
(deny file-write* (literal (string-append (param "_HOME") "/.zshrc")))
(deny file-write* (literal (string-append (param "_HOME") "/.bashrc")))
(deny file-write* (literal (string-append (param "_HOME") "/.profile")))
(deny file-write* (literal (string-append (param "_HOME") "/.zprofile")))
(deny file-write* (literal (string-append (param "_HOME") "/.zshenv")))
(deny file-write* (literal (string-append (param "_HOME") "/.zlogout")))
(deny file-write* (literal (string-append (param "_HOME") "/.bash_profile")))

;; ---------------------------------------------------------------------------
;; Mandatory write denies — defense-in-depth (PROJECT)
;; ---------------------------------------------------------------------------
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.git/hooks")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.git/config")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.bashrc")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.zshrc")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.gitconfig")))
(deny file-write* (literal (string-append (param "_PROJECT_DIR") "/.mcp.json")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.vscode")))
(deny file-write* (subpath (string-append (param "_PROJECT_DIR") "/.idea")))

;; ---------------------------------------------------------------------------
;; The daemons' own state — last, so nothing above can re-grant it
;; ---------------------------------------------------------------------------
;; The read half of this is in the read section, with the reasoning. The write
;; half is here because `_PROJECT_DIR` is granted writes a few rules above, and
;; that path is built from a name a frontend supplies -- on Slack, partly from a
;; string a message sender chooses. `agent.workspace_path` reduces that name so it
;; can no longer name an ancestor of this directory, and this placement is what
;; makes the deny hold even if it ever could. The journal under state/ replays its
;; entries as user messages at the next start, so a writable journal is a prompt
;; the agent schedules for itself past any approval the operator set.
(deny file-write* (subpath (string-append (param "_HOME") "/.claude-on-the-fly/state")))
(deny file-write* (subpath (string-append (param "_DATA_DIR") "/state")))
