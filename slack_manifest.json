{
  "display_information": {
    "name": "Claude On The Fly",
    "description": "Remote Claude Code access via Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Claude On The Fly",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read"
      ],
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "search:read",
        "usergroups:read",
        "usergroups:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
