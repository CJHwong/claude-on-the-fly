# Telegram (required for claude-telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Reply footer mode: off | summary | detailed (default: summary)
# off      = no stats footer
# summary  = cost/duration/tokens/model line
# detailed = summary + tool-use breakdown
# TELEGRAM_STATS_MODE=summary

# Slack (required for claude-slack)
SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...
# Optional: comma-separated list of additional allowed Slack user IDs
# Your own user ID (resolved from the user token) is always included
# Comma-separated Slack user IDs. Set to "*" to allow any sender (applies to channels and DMs).
SLACK_ALLOWED_USER_IDS=
# Comma-separated Slack user IDs to deny, even when SLACK_ALLOWED_USER_IDS="*".
SLACK_BLOCKED_USER_IDS=
# Comma-separated bot IDs (e.g. B07JPABE2) whose app/bot posts should trigger Claude
# (HubSpot, Jira, etc.). Bot posts are dropped by default. No "*" wildcard: it would
# loop on this app's own echoed messages. Do not list this app's own bot ID.
SLACK_ALLOWED_BOT_IDS=
# SLACK_STATS_MODE=summary

# Gmail (required for claude-gmail)
GMAIL_GCP_PROJECT=
# Comma-separated. Entries may be exact addresses (alice@example.com),
# domain wildcards (*@gofreight.com), or "*" to allow any sender.
GMAIL_ALLOWED_SENDERS=
# Optional: polling interval in seconds (default: 5)
# GMAIL_POLL_INTERVAL=5
# GMAIL_STATS_MODE=summary

# Model used for the underlying `claude` CLI (default: sonnet)
# CLAUDE_MODEL=sonnet

# Model used for the underlying `codex` CLI
# CODEX_MODEL=o3

# Model used for the underlying `pi` CLI
# PI_MODEL=deepseek-v4-flash:cloud

# Provider for pi CLI (default: google)
# PI_PROVIDER=ollama

# Agent backend: claude (default), codex, or pi
# AGENT_BACKEND=claude

# Mode for each backend: native, ollama (claude also supports: pty)
# CLAUDE_MODE=native
# CODEX_MODE=native
# PI_MODE=native

# Ollama model name (required when *_MODE=ollama)
# OLLAMA_MODEL=deepseek-v4-flash:cloud
