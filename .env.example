# Telegram (required for claude-telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Slack (required for claude-slack)
SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=UXXXXXXXX
# Optional: comma-separated list of additional allowed Slack user IDs
# SLACK_USER_ID is always included automatically
SLACK_ALLOWED_USER_IDS=
