# Telegram (required for claude-telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Reply footer mode: off | summary | detailed (default: summary)
# off      = no stats footer
# summary  = cost/duration/tokens/model line
# detailed = summary + tool-use breakdown
# TELEGRAM_STATS_MODE=summary

# Slack (required for claude-slack)
SLACK_APP_TOKEN=xapp-...
# Bearer token — kind is inferred from the prefix:
#   xoxp-... replies as you, sees everything you can see.
#   xoxb-... replies as the app; the bot must be in each channel (fine for DMs).
SLACK_TOKEN=xoxb-...
# Comma-separated sender IDs allowed to trigger Claude. Users (U…/W…) and bots
# (B…, e.g. B07JPABE2 for HubSpot/Jira) go in the same list; bots bypass the
# @mention gate. The token's own ID is always allowed — with a bot token that's
# the BOT's id, so add your own U… id here (or "*") to let your DMs through.
# "*" allows any human sender; bots always need an explicit id.
SLACK_ALLOWED_SENDER_IDS=
# Comma-separated sender IDs (users or bots) to deny; wins over the allowlist.
SLACK_BLOCKED_SENDER_IDS=
# Comma-separated sender IDs (users or bots) that trigger Claude but get no reply.
SLACK_SILENT_SENDER_IDS=
# SLACK_STATS_MODE=summary

# Model used for the underlying `claude` CLI (default: sonnet)
# CLAUDE_MODEL=sonnet

# Model used for the underlying `codex` CLI
# CODEX_MODEL=o3

# Agent backend: claude (default) or codex
# AGENT_BACKEND=claude

# Mode for each backend: native, ollama (claude also supports: pty)
# CLAUDE_MODE=native
# CODEX_MODE=native

# Ollama model name (required when *_MODE=ollama)
# OLLAMA_MODEL=deepseek-v4-flash:cloud

# Sandbox the agent so it never holds API keys (default: off). See
# docs/agent/broker.md. Requires keychain items named cotf-<provider>, e.g.
#   security add-generic-password -a "$USER" -s cotf-anthropic -w "<key>" -U
# off  = inherit full env (current behavior)
# env  = curate env (drop secrets, route via broker); cross-platform
# jail = curated env + seatbelt egress lock + keychain deny (macOS; profiles
#        vendored, nothing to install)
# COTF_SANDBOX=off
#
# Optional least-privilege knobs, all jail-mode only and default off:
# COTF_SANDBOX_FS=deny-most        # $HOME opaque; re-grant project/.claude/.cache/uv
# COTF_SANDBOX_EXTRA_PATHS=/a:/b   # extra read grants for deny-most (max 3)
# COTF_SANDBOX_BROKER_ONLY_LOOPBACK=1  # egress to the broker + egress-proxy ports only

# Extra hosts the CONNECT egress proxy allows without asking (comma-separated).
# Any host not listed pauses the agent's request while the operator is asked, so
# front-load what a job is known to need.
#
# The model APIs are already built in (api.anthropic.com, api.openai.com,
# chatgpt.com, ab.chatgpt.com) because no backend works without them. Package
# registries, github.com, telemetry, and self-update endpoints are NOT, because
# each is a real decision: an install is arbitrary code execution, github.com
# grants writes, telemetry is optional by definition.
# COTF_EGRESS_ALLOW=pypi.org,files.pythonhosted.org,registry.npmjs.org,github.com,api.github.com

# Approval prompts go to the conversation whose agent triggered them, so no
# routing config is needed. Slack additionally requires a bot token (xoxb-),
# because button clicks only reach a bot-token install; work with no
# conversation behind it (cron, the job queue) has nobody to ask and is denied.
# Telegram only: pin prompts to one chat instead of the session's own.
# COTF_APPROVAL_CHAT_ID=123456789

# Write message text to the log. Off by default: the log directory is shaped for
# a file syncer, so anything here should be assumed to leave the machine and to
# sit there for COTF_LOG_KEEP_DAYS. With it off, prompts and replies are recorded
# as a length, and a brokered command's long argv tokens (a `--body` payload) are
# clipped. Turn it on while actively debugging a message-handling problem, then
# turn it back off.
# COTF_LOG_CONTENT=1
